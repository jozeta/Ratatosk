# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Environment / secrets
.env
*.env.local

# Database
*.db
*.db-journal
# SQLite WAL-mode companions hold recent database pages - never commit them
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite
*.sqlite3

# Runtime storage (encrypted blobs and in-progress uploads must never be committed)
storage/encrypted/*
storage/tmp/*
storage/branding/*
!storage/encrypted/.gitkeep
!storage/tmp/.gitkeep
!storage/branding/.gitkeep

# Docker volume mount target
data/

# Logs
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Dev-only JS tooling
node_modules/

# Local assistant session notes
.remember/

# Personal Claude Code settings (not shared)
.claude/settings.local.json

# --- Baseline: macOS, Claude Code and secrets ---
._*
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
