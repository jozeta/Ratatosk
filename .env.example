# Copy to .env and fill in before running docker-compose up
SECUREDROP_SECRET_KEY=change_this_to_a_random_32plus_character_secret
SECUREDROP_DEFAULT_ADMIN_USERNAME=admin
# Leave blank to auto-generate a random admin password (printed to container logs on first init)
SECUREDROP_DEFAULT_ADMIN_PASSWORD=

# Optional: S3-compatible storage backend instead of local disk (AWS S3, MinIO, Backblaze B2, etc).
# Leave SECUREDROP_STORAGE_BACKEND unset (or "local") to keep using the local filesystem.
# SECUREDROP_STORAGE_BACKEND=s3
# SECUREDROP_S3_BUCKET=
# SECUREDROP_S3_REGION=
# SECUREDROP_S3_ENDPOINT_URL=
# SECUREDROP_S3_ACCESS_KEY_ID=
# SECUREDROP_S3_SECRET_ACCESS_KEY=
# SECUREDROP_S3_PREFIX=
