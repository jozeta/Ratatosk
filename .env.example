# Copy to .env and fill in before running `docker compose up` (or uvicorn).
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
RATATOSK_SECRET_KEY=change_this_to_a_random_32plus_character_secret
RATATOSK_DEFAULT_ADMIN_USERNAME=admin
# Leave blank to auto-generate a random admin password (printed once on first init)
RATATOSK_DEFAULT_ADMIN_PASSWORD=

# Where encrypted files are stored (local backend). Env-only by design.
# RATATOSK_STORAGE_ROOT=./storage/encrypted

# Optional: S3-compatible storage backend instead of local disk (AWS S3, MinIO, Backblaze B2, etc).
# Leave RATATOSK_STORAGE_BACKEND unset (or "local") to keep using the local filesystem.
# RATATOSK_STORAGE_BACKEND=s3
# RATATOSK_S3_BUCKET=
# RATATOSK_S3_REGION=
# RATATOSK_S3_ENDPOINT_URL=
# RATATOSK_S3_ACCESS_KEY_ID=
# RATATOSK_S3_SECRET_ACCESS_KEY=
# RATATOSK_S3_PREFIX=

# Older SECUREDROP_* names still work, with a deprecation warning.
